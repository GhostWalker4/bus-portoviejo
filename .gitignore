# Recorridos GPS: son datos personales de quien llevaba el celular.
# Antes de compartir uno, recorta los tramos cerca de casas y súbelo a datos/ a mano.
*.gpx
!datos/**/*.gpx

# Python
__pycache__/
*.pyc
.venv/
venv/
servidor/db.sqlite3
servidor/staticfiles/
.env

# Node / Expo (el resto está en movil/.gitignore)
node_modules/

# Configuración de cada persona y de cada herramienta
.claude/
!movil/.claude/
.claude/settings.local.json
.vscode/
.idea/
.DS_Store
Thumbs.db

# Archivos que genera datos/convertir_a_gtfs.py y que cada uno regenera
datos/.cache_osrm.json
datos/vista_previa.geojson
datos/ejemplo/gtfs/
